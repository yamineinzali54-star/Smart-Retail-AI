# Copy this file to .env and set the required values for your environment.
# Never commit .env or put the web app's owner DATABASE_URL in this service.

# Database: use the dedicated smartretail_ai_reader role (SELECT-only).
AI_DATABASE_URL=postgresql://smartretail_ai_reader:replace-me@localhost:5432/smartretail

# Must match AI_SERVICE_TOKEN in web-app/.env.local.
# Generate a long random secret and replace this placeholder.
AI_SERVICE_TOKEN=replace-with-a-long-random-shared-secret

# Redis is required by the background worker and stream consumer.
REDIS_URL=redis://localhost:6379/0

# OpenRouter for service-configured non-chat LLM jobs (for example, forecast narration).
# Chat always uses the model and credential selected in the web app's Chat UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny

# Model defaults for non-chat service jobs; Chat UI selection is used for chat.
AI_MODEL_SQL=qwen/qwen3.8-27b:free
AI_MODEL_NARRATE=google/gemma-4-31b-it:free
AI_MODEL_FALLBACK=openrouter/free

# Comma-separated branch codes processed by the nightly Celery beat jobs.
NIGHTLY_BRANCH_CODES=YGN
